NODE_ENV=development
PORT=3000

# PostgreSQL (pgvector image)
DATABASE_URL=postgresql://sentifix:secret@localhost:5433/sentifix
# In production (NODE_ENV=production), TypeORM synchronize is off. Set this to true so the
# app creates its entity tables on first boot (entity tables have no migrations). Managed
# deploys (see render.yaml / DEPLOY.md) set this automatically. Leave unset for local dev.
# DB_SYNCHRONIZE=false

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Model selection. These are catalog KEYS from src/llm/model-catalog.ts, not
# vendor model IDs — the vendor is looked up per call, so one deployment can
# serve OpenAI tenants and Bedrock (Claude) tenants at the same time.
# Keys: gpt-5.6-luna | gpt-5.6-terra | gpt-5.6-sol   (OpenAI — needs OPENAI_API_KEY)
#       claude-haiku | claude-sonnet | claude-opus   (Anthropic — needs AWS Bedrock access)
# Run `pnpm check:models --invoke` to see which of these actually work today.
#
# Default for tenants that have not chosen a model (installations.model_key /
# slack_installations.model_key null).
DEFAULT_CHAT_MODEL=gpt-5.6-luna
# DEFAULT_RERANK_MODEL=gpt-5.6-luna   # defaults to DEFAULT_CHAT_MODEL

# The eval judge is pinned for everyone and is NOT client-selectable — scores are
# only comparable across tenants if every run is graded by the same model.
JUDGE_MODEL=gpt-5.6-sol

# Escalation. Run every bug on the tenant's (cheap) model, let the judge score the
# fix, and retry once on a stronger model only when the score is poor — so the
# second call is paid on the minority of bugs that actually need it. Whichever
# diff scores higher is the one that ships.
#
# Off by default: measure first. Run your eval harness on the cheap model over a
# batch of real issues — if most already clear the threshold this is a large
# saving; if most fail it you will pay twice on nearly every run, and raising
# DEFAULT_CHAT_MODEL is the cheaper answer.
#
# Only applies when ESCALATION_MODEL outranks the tenant's own model, so an Opus
# tenant is never "escalated" down to something cheaper.
# Admin API (tier changes, manual top-ups). Fails CLOSED — with neither of these
# set, every /admin route returns 401 rather than falling open. Use a value
# distinct from API_KEY so a leaked read key cannot move money.
# ADMIN_API_KEY=

# Billing. 1 credit = USD 0.01 of customer-facing value; CREDIT_MARKUP is the
# multiple of vendor token cost you charge. Off until you are ready to charge.
BILLING_ENABLED=false
# CREDIT_MARKUP=2
FREE_GRANT_CREDITS=500        # ~97 runs on the default tier (gpt-5.6-luna)
# ESTIMATE_INPUT_TOKENS=80000 # sizes the pre-run hold; tune from usage_records
# ESTIMATE_OUTPUT_TOKENS=8000
# HOLD_TTL_MS=900000          # stranded holds from dead workers expire after this

# Stripe. Packs are defined in src/billing/credit-packs.ts:
#   Starter $20 -> 2,000 credits | Team $100 -> 11,000 (+10%) | Scale $500 -> 60,000 (+20%)
# Credits are granted by the WEBHOOK, never by the success redirect — a redirect
# proves a browser loaded a page, not that Stripe captured the money.
# Point a Stripe endpoint at POST /webhooks/stripe for checkout.session.completed.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# LOW_BALANCE_THRESHOLD_CREDITS=250   # ~49 runs on the default tier
# LOW_BALANCE_COOLDOWN_HOURS=24       # warn at most this often, or it becomes noise

ESCALATION_ENABLED=false
# ESCALATION_MODEL=gpt-5.6-sol   # or claude-opus once Bedrock access is granted
# ESCALATION_THRESHOLD=0.6

# Only needed once a Bedrock-backed (Claude) model is actually selected; the
# client is built lazily, so an OpenAI-only deployment can leave this unset.
# No key here: credentials come from the standard AWS chain, which on EC2 means
# the instance role. Grant model access per-region in the Bedrock console first.
# AWS_REGION=ap-northeast-1
# BEDROCK_MAX_TOKENS=16000  # caps thinking + response together on Opus-tier models

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Reranking (precision stage after retrieval). RERANK_ENABLED=false disables the extra LLM call.
RERANK_ENABLED=true
RERANK_TOP_N=8

# GitHub
GITHUB_WEBHOOK_SECRET=changeme
# GITHUB_TOKEN=ghp_...   (optional, avoids rate limits and enables private repos)

# Which issues to auto-triage (protects your LLM spend on busy repos):
#   all           = every opened/reopened issue (default)
#   label:bug     = only issues with the "bug" label
#   command       = none automatically; only when someone comments "/sentifix"
# A "/sentifix" issue comment always triggers a (re)triage regardless of this.
# Requires the webhook to subscribe to "Issue comments" events for command/manual use.
# SENTIFIX_TRIGGER=all

# Max triage runs per tenant (GitHub installation, else per repo) per rolling 24h.
# Protects your LLM spend on a public multi-tenant deploy. 0 = unlimited (default).
# TRIAGE_DAILY_LIMIT=50

# REST API auth — if set, all /triage and /index endpoints require X-Api-Key header
# API_KEY=your-secret-key

# ── Multi-tenant SaaS mode (optional) ─────────────────────────────────────────
# When true, the dashboard/setup/API require GitHub login and show each user only
# their own installations' data. Leave false for open single-tenant self-hosting.
# Needs a GitHub App with an OAuth callback at <APP_BASE_URL>/auth/callback.
# DASHBOARD_AUTH=false

# Who may use the product once signed in. GitHub OAuth proves identity; this
# decides entitlement. 'open' (default) keeps self-host behaviour: anyone who
# authenticates is a user — fine privately, wrong the moment the URL is shared.
# 'approval' puts new logins in a queue you review at /admin.
#
# Set ACCESS_BOOTSTRAP_LOGINS to your own GitHub login BEFORE switching to
# approval, or nobody can approve anyone, including you. It fails closed.
ACCESS_MODE=open
# ACCESS_BOOTSTRAP_LOGINS=your-github-login,cofounder-login
# SESSION_SECRET=            # long random string; openssl rand -hex 32
# APP_BASE_URL=https://your-domain.com

# ── Slack integration (optional — enables @sentifix mentions in channels) ──────
# Create at: api.slack.com/apps → Create New App → From Scratch
# Bot Token Scopes: app_mentions:read, chat:write, chat:write.public
# Event Subscriptions: app_mention → Request URL: https://your-domain/webhooks/slack
#
# SLACK_SIGNING_SECRET=abc123            # per-app; verifies inbound requests
# SLACK_DEFAULT_REPO=your-org/your-repo  # global fallback when repo not mentioned
# SLACK_BOT_TOKEN=xoxb-...               # legacy single-workspace fallback (optional)
#
# Multi-tenant "Add to Slack" (each workspace installs & we store its own token):
# SLACK_CLIENT_ID=...
# SLACK_CLIENT_SECRET=...
# Redirect URL in your Slack app: <APP_BASE_URL>/slack/oauth/callback

# ── Rate limiting ───────────────────────────────────────────────────────────────
# Default: 60 requests/minute per IP across all non-webhook endpoints.
# Webhook endpoints (/webhooks/github, /webhooks/slack) are always exempt.

# ── OpenTelemetry tracing (optional) ────────────────────────────────────────────
# Set OTEL_ENABLED=true to ship traces to any OTLP-compatible backend
# (Jaeger, Grafana Tempo, Honeycomb, Datadog, etc.)
#
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=sentifix
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ── GitHub App (optional — enables one-click install instead of manual webhooks) ──
# Create at: https://github.com/settings/apps/new
# Required permissions: Issues (R/W), Pull Requests (W), Contents (W), Metadata (R)
# Required events: installation, installation_repositories, issues, push
# Webhook URL: https://your-domain.com/webhooks/github
#
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=sentifix-bot          # the app's slug from its GitHub URL
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----
# GITHUB_APP_CLIENT_ID=Iv1.abc123
# GITHUB_APP_CLIENT_SECRET=abc123
