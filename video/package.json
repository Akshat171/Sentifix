{
  "name": "sentifix-video",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion source for the Sentifix launch video",
  "license": "MIT",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render": "remotion render LaunchVideo out/sentifix-launch.mp4 --codec=h264 --crf=18",
    "render:vertical": "remotion render LaunchVideoVertical out/sentifix-launch-9x16.mp4 --codec=h264 --crf=18",
    "render:pipeline": "remotion render LaunchVideo out/pipeline.mp4 --frames=300-1079 --muted --codec=h264 --crf=18",
    "still": "remotion still LaunchVideo out/thumbnail.png --frame=2150",
    "data": "node scripts/build-data.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.514",
    "@remotion/google-fonts": "4.0.514",
    "@remotion/media-utils": "4.0.514",
    "@remotion/shapes": "4.0.514",
    "@remotion/transitions": "4.0.514",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.514"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
